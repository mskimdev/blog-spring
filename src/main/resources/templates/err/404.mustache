{{> layout/header}}
<div class="container flex-grow-1 d-flex align-items-center justify-content-center py-5">
    <div class="text-center">
        <div class="mb-3" style="font-size: 5rem; font-weight: 800; color: #e2e8f0; line-height: 1;">404</div>
        <h4 class="fw-bold mb-2" style="color: #1e1b4b;">페이지를 찾을 수 없습니다</h4>
        <p class="text-muted mb-1">{{message}}</p>
        <p class="text-muted small mb-4">요청하신 페이지가 존재하지 않거나 이동되었습니다.</p>
        <a href="/" class="btn btn-primary rounded-pill px-5" style="background: #6366f1; border: none;">
            <i class="fa fa-house me-1"></i>메인으로
        </a>
    </div>
</div>
{{> layout/footer}}
