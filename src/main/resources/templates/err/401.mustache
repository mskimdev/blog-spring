{{> layout/header}}
<div class="container flex-grow-1 d-flex align-items-center justify-content-center py-5">
    <div class="text-center">
        <div class="mb-3" style="font-size: 5rem; font-weight: 800; color: #e2e8f0; line-height: 1;">401</div>
        <h4 class="fw-bold mb-2" style="color: #1e1b4b;">인증이 필요합니다</h4>
        <p class="text-muted mb-1">{{message}}</p>
        <p class="text-muted small mb-4">이 페이지에 접근하려면 로그인이 필요합니다.</p>
        <div class="d-flex justify-content-center gap-2">
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa fa-arrow-left me-1"></i>이전 페이지
            </a>
            <a href="/login-form" class="btn btn-primary rounded-pill px-4" style="background: #6366f1; border: none;">
                <i class="fa fa-right-to-bracket me-1"></i>로그인
            </a>
        </div>
    </div>
</div>
<script>
    {{#msg}}
    alert("{{msg}}");
    location.href = "/login-form";
    {{/msg}}
</script>
{{> layout/footer}}
