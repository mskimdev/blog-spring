<!DOCTYPE html>
<html lang="ko">

<head>
    <title>Blog</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --surface: #f8fafc;
            --border: #e2e8f0;
            --text-muted: #64748b;
        }
        body {
            background-color: var(--surface);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }
        .navbar {
            background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%) !important;
            box-shadow: 0 2px 12px rgba(0,0,0,0.15);
            padding: 0.75rem 0;
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.4rem;
            letter-spacing: -0.5px;
            color: #fff !important;
        }
        .navbar-brand span {
            color: #a5b4fc;
        }
        .nav-link {
            color: rgba(255,255,255,0.8) !important;
            font-weight: 500;
            padding: 0.4rem 0.9rem !important;
            border-radius: 6px;
            transition: all 0.2s;
        }
        .nav-link:hover {
            background: rgba(255,255,255,0.12);
            color: #fff !important;
        }
        .btn-nav-write {
            background: var(--primary);
            color: #fff !important;
            border-radius: 6px;
        }
        .btn-nav-write:hover {
            background: var(--primary-dark);
            color: #fff !important;
        }
    </style>
</head>

<body class="d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-sm">
    <div class="container">
        <a class="navbar-brand" href="/">Ten<span>coding</span></a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="collapsibleNavbar">
            <ul class="navbar-nav ms-auto gap-1">
                {{#sessionUser}}
                    <li class="nav-item">
                        <a class="nav-link btn-nav-write" href="/board/save-form">
                            <i class="fa fa-pen-to-square me-1"></i>글쓰기
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/user/update-form">
                            <i class="fa fa-user me-1"></i>내 정보
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/logout">
                            <i class="fa fa-right-from-bracket me-1"></i>로그아웃
                        </a>
                    </li>
                {{/sessionUser}}
                {{^sessionUser}}
                    <li class="nav-item">
                        <a class="nav-link" href="/join-form">
                            <i class="fa fa-user-plus me-1"></i>회원가입
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/login-form">
                            <i class="fa fa-right-to-bracket me-1"></i>로그인
                        </a>
                    </li>
                {{/sessionUser}}
            </ul>
        </div>
    </div>
</nav>
