{{> layout/header}}
<div class="container py-5 flex-grow-1 d-flex align-items-center justify-content-center">
    <div class="w-100" style="max-width: 480px;">
        <div class="text-center mb-4">
            <i class="fa fa-user-gear" style="font-size: 2.5rem; color: #6366f1;"></i>
            <h4 class="fw-bold mt-2 mb-1" style="color: #1e1b4b;">회원정보 수정</h4>
            <p class="text-muted small">변경할 정보를 입력하세요</p>
        </div>
        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-body p-4 p-md-5">
                <form action="/user/update" method="post" enctype="multipart/form-data">
                    <!-- 프로필 이미지 표시 -->
                    <input type="hidden" name="deleteProfileImg" id="deleteProfileImgFlag" value="false">
                    <div class="mb-4 text-center">
                        <div class="position-relative d-inline-block">
                            <img id="profilePreview"
                                 src="{{#user.profileImg}}/images/{{user.profileImg}}{{/user.profileImg}}{{^user.profileImg}}/images/default-profile.png{{/user.profileImg}}"
                                 alt="프로필 이미지"
                                 style="width: 90px; height: 90px; border-radius: 50%; object-fit: cover; border: 3px solid #e2e8f0;">
                            <button type="button" id="deleteProfileBtn"
                                    onclick="clearProfileImg()"
                                    class="btn btn-sm position-absolute"
                                    style="top: 0; right: 0; width: 24px; height: 24px; padding: 0; border-radius: 50%; background: #ef4444; color: #fff; font-size: 0.65rem; line-height: 1; border: 2px solid #fff;">
                                <i class="fa fa-x"></i>
                            </button>
                        </div>
                        <div class="mt-2">
                            <label class="form-label fw-semibold text-secondary small d-block">프로필 이미지 변경 <span class="text-muted fw-normal">(선택)</span></label>
                            <input type="file" class="form-control" name="profileImg" id="profileImg"
                                   accept="image/*"
                                   style="border-radius: 10px; border-color: #e2e8f0; padding: 0.45rem 0.75rem;">
                            <div class="form-text text-muted" style="font-size: 0.75rem;">JPG, PNG, GIF 등 이미지 파일 (최대 50MB)</div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">아이디</label>
                        <input type="text" class="form-control bg-light text-muted" name="username"
                               value="{{user.username}}" disabled
                               style="border-radius: 10px; border-color: #e2e8f0; padding: 0.65rem 1rem;">
                        <div class="form-text">아이디는 변경할 수 없습니다.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">새 비밀번호</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0" style="border-radius: 10px 0 0 10px; border-color: #e2e8f0;">
                                <i class="fa fa-lock text-muted"></i>
                            </span>
                            <input type="password" class="form-control border-start-0 ps-2" name="password"
                                   placeholder="새 비밀번호를 입력하세요"
                                   style="border-radius: 0 10px 10px 0; border-color: #e2e8f0; padding: 0.65rem 1rem;">
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary small">이메일</label>
                        <input type="text" class="form-control bg-light text-muted" name="email"
                               value="{{user.email}}" disabled
                               style="border-radius: 10px; border-color: #e2e8f0; padding: 0.65rem 1rem;">
                        <div class="form-text">이메일은 변경할 수 없습니다.</div>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/" class="btn btn-outline-secondary rounded-pill px-4 flex-fill text-center">취소</a>
                        <button type="submit" class="btn fw-semibold rounded-pill px-4 flex-fill"
                                style="background: #6366f1; color: #fff; border: none;">
                            <i class="fa fa-check me-1"></i>수정 완료
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    document.getElementById('profileImg').addEventListener('change', function () {
        const file = this.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = e => document.getElementById('profilePreview').src = e.target.result;
            reader.readAsDataURL(file);
            document.getElementById('deleteProfileImgFlag').value = 'false';
        }
    });

    function clearProfileImg() {
        document.getElementById('profilePreview').src = '/images/default-profile.png';
        document.getElementById('profileImg').value = '';
        document.getElementById('deleteProfileImgFlag').value = 'true';
    }
</script>
{{> layout/footer}}
