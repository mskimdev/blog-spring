{{> layout/header}}
<div class="container py-5 flex-grow-1 d-flex align-items-center justify-content-center">
    <div class="w-100" style="max-width: 440px;">
        <div class="text-center mb-4">
            <i class="fa fa-user-plus" style="font-size: 2.5rem; color: #6366f1;"></i>
            <h4 class="fw-bold mt-2 mb-1" style="color: #1e1b4b;">회원가입</h4>
            <p class="text-muted small">Tencoding에 오신 것을 환영합니다</p>
        </div>
        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-body p-4 p-md-5">
                <!-- ! 중요 !
                    파일 업로드 사용 시 method(POST) enctype을 반드시 multipart/form-data 설정 해주어야 함
                    설정 하지 않으면 서버측에서 이미지를 수신하지 못함
                -->
                <form action="/join" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">아이디</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0" style="border-radius: 10px 0 0 10px; border-color: #e2e8f0;">
                                <i class="fa fa-user text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0 ps-2" name="username" value="ssar2"
                                   placeholder="사용할 아이디를 입력하세요"
                                   style="border-radius: 0 10px 10px 0; border-color: #e2e8f0; padding: 0.65rem 1rem;">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">비밀번호</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0" style="border-radius: 10px 0 0 10px; border-color: #e2e8f0;">
                                <i class="fa fa-lock text-muted"></i>
                            </span>
                            <input type="password" class="form-control border-start-0 ps-2" name="password" value="123456"
                                   placeholder="비밀번호를 입력하세요"
                                   style="border-radius: 0 10px 10px 0; border-color: #e2e8f0; padding: 0.65rem 1rem;">
                        </div>
                    </div>
                    <!-- 프로필 이미지 등록 필드(선택 사항) -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">프로필 이미지 <span class="text-muted fw-normal">(선택)</span></label>
                        <div class="d-flex align-items-center gap-3">
                            <div class="flex-shrink-0">
                                <img id="profilePreview" src="/images/default-profile.png" alt="프로필 미리보기"
                                     style="width: 64px; height: 64px; border-radius: 50%; object-fit: cover; border: 2px solid #e2e8f0;">
                            </div>
                            <div class="flex-grow-1">
                                <input type="file" class="form-control" name="profileImg" id="profileImg"
                                       accept="image/*"
                                       style="border-radius: 10px; border-color: #e2e8f0; padding: 0.45rem 0.75rem;">
                                <div class="form-text text-muted" style="font-size: 0.75rem;">JPG, PNG, GIF 등 이미지 파일 (최대 50MB)</div>
                            </div>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary small">이메일</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0" style="border-radius: 10px 0 0 10px; border-color: #e2e8f0;">
                                <i class="fa fa-envelope text-muted"></i>
                            </span>
                            <input type="email" class="form-control border-start-0 ps-2" name="email" value="aa@naver.com"
                                   placeholder="이메일을 입력하세요"
                                   style="border-radius: 0 10px 10px 0; border-color: #e2e8f0; padding: 0.65rem 1rem;">
                        </div>
                    </div>
                    <button type="submit" class="btn w-100 fw-semibold py-2"
                            style="background: #6366f1; color: #fff; border-radius: 10px; border: none;">
                        가입하기
                    </button>
                </form>
            </div>
        </div>
        <p class="text-center text-muted small mt-3">
            이미 계정이 있으신가요?
            <a href="/login-form" class="text-decoration-none fw-semibold" style="color: #6366f1;">로그인</a>
        </p>
    </div>
</div>
<script>
    document.getElementById('profileImg').addEventListener('change', function () {
        const file = this.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = e => document.getElementById('profilePreview').src = e.target.result;
            reader.readAsDataURL(file);
        }
    });
</script>
{{> layout/footer}}
