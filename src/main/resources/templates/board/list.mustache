{{> layout/header}}
<div class="container py-5 flex-grow-1">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0" style="color: #1e1b4b;">
            <i class="fa fa-newspaper me-2" style="color: #6366f1;"></i>게시글 목록
        </h4>
        {{#sessionUser}}
        <a href="/board/save-form" class="btn btn-primary rounded-pill px-4" style="background: #6366f1; border: none;">
            <i class="fa fa-pen-to-square me-1"></i>글쓰기
        </a>
        {{/sessionUser}}
    </div>

    {{#boardPage.list}}
    <div class="card mb-3 border-0 shadow-sm" style="border-radius: 12px; transition: transform 0.15s, box-shadow 0.15s;"
         onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,0.1)'"
         onmouseout="this.style.transform='';this.style.boxShadow=''">
        <div class="card-body px-4 py-3">
            <h5 class="card-title fw-semibold mb-1" style="color: #1e1b4b;">{{title}}</h5>
            <p class="text-muted small mb-2">
                <i class="fa fa-user me-1"></i>{{username}}
                <span class="mx-2">·</span>
                <i class="fa fa-calendar me-1"></i>{{createdAt}}
            </p>
            <a href="/board/{{id}}" class="btn btn-sm btn-outline-primary rounded-pill px-3" style="border-color: #6366f1; color: #6366f1;">
                상세보기 <i class="fa fa-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
    {{/boardPage.list}}

    {{^boardPage.list}}
    <div class="text-center py-5 text-muted">
        <i class="fa fa-inbox" style="font-size: 3rem; opacity: 0.3;"></i>
        <p class="mt-3">아직 작성된 게시글이 없습니다.</p>
    </div>
    {{/boardPage.list}}

    <!-- Pagination -->
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <!-- 이전 페이지 버튼 (첫 페이지 disabled 처리)-->
            <li class="page-item {{#boardPage.first}}disabled{{/boardPage.first}}">
                <a href="/board/list?page={{boardPage.prevPage}}&size={{boardPage.size}}" class="page-link rounded-start-pill">
                    <i class="fa fa-chevron-left me-1"></i>이전
                </a>
            </li>

            <!-- 페이지 번호 윈도우 (햔재 페이지 기준 앞뒤 2페이지 최대 5개 -->
            {{#boardPage.pageItemNumbers}}
                <li class="page-item {{#active}}active{{/active}}"><a href = "/board/list?page={{number}}&size={{boardPage.size}}" class="page-link">{{number}}</a></li>
            {{/boardPage.pageItemNumbers}}

            <li class="page-item {{#boardPage.last}}disabled{{/boardPage.last}}">
                <a href="/board/list?page={{boardPage.nextPage}}&size={{boardPage.size}}" class="page-link rounded-end-pill">
                    다음<i class="fa fa-chevron-right ms-1"></i>
                </a>
            </li>
        </ul>
    </nav>
    <!-- pagination end -->
</div>

{{> layout/footer}}
