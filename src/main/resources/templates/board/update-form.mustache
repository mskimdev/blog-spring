{{> layout/header}}
<div class="container py-5 flex-grow-1" style="max-width: 720px;">
    <div class="card border-0 shadow-sm" style="border-radius: 16px;">
        <div class="card-header bg-white px-4 py-3 border-bottom" style="border-color: #e2e8f0; border-radius: 16px 16px 0 0;">
            <h5 class="fw-bold mb-0" style="color: #1e1b4b;">
                <i class="fa fa-pen me-2" style="color: #f59e0b;"></i>게시글 수정
            </h5>
        </div>
        <div class="card-body p-4 p-md-5">
            <form action="/board/{{id}}/update" method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">작성자</label>
                    <input type="text" name="username" class="form-control bg-light text-muted"
                           value="{{board.username}}" readonly disabled
                           style="border-radius: 10px; border-color: #e2e8f0; padding: 0.65rem 1rem;">
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold text-secondary small">제목</label>
                    <input type="text" name="title" class="form-control"
                           placeholder="제목을 입력하세요" value="{{board.title}}"
                           style="border-radius: 10px; border-color: #e2e8f0; padding: 0.65rem 1rem;">
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold text-secondary small">내용</label>
                    <textarea name="content" rows="10" class="form-control"
                              placeholder="내용을 입력하세요"
                              style="border-radius: 10px; border-color: #e2e8f0; padding: 0.65rem 1rem; resize: vertical;">{{board.content}}</textarea>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <a href="/board/{{id}}" class="btn btn-outline-secondary rounded-pill px-4">취소</a>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 fw-semibold">
                        <i class="fa fa-check me-1"></i>수정 완료
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

{{> layout/footer}}
